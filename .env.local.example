NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never prefix with NEXT_PUBLIC_. Bypasses RLS. Used only to
# create/update login credentials (identifiant + mot de passe).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Fine-grained GitHub PAT, scope Issues:write on
# W1nn13Th3P00h/NikoNiko. Used by the "signaler un bug" button
# (app/actions/bug-report.ts) to create GitHub issues.
GITHUB_ISSUES_TOKEN=

# Web Push (rappels de séance, issue #27). Générés une fois avec
# `npx web-push generate-vapid-keys` — mêmes valeurs partout (local +
# Netlify), à ne jamais régénérer sans mettre à jour les deux côtés
# (ça invaliderait tous les abonnements existants).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
